rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'anonymous');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'gestionaq26@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'Administrador')
      );
    }

    function isSupervisorOrAdmin() {
      return isAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'Supervisor' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'Administrador')
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.:]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Connection test document
    match /test/{testId} {
      allow read, write: if true;
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(userId) && (
        isAdmin() || (request.auth.uid == userId && incoming().rol != 'Administrador')
      );
      allow update: if isSignedIn() && isValidId(userId) && (
        isAdmin() || (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['nombre', 'updatedAt']))
      );
      allow delete: if isAdmin();
    }

    // App State / Global Catalogs
    match /app_state/{stateId} {
      allow read: if true;
      allow write: if isSignedIn() || isAdmin();
    }

    // Trabajadores (Worker Roster)
    match /trabajadores/{trabajadorId} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidId(trabajadorId) &&
        incoming().dni is string && incoming().dni.size() <= 20 &&
        incoming().nombres is string && incoming().nombres.size() <= 128;
      allow delete: if isSupervisorOrAdmin();
    }

    // Detalle Jabas (Harvest Scans)
    match /detalle_jabas/{jabaId} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidId(jabaId) &&
        incoming().dni is string && incoming().dni.size() <= 20 &&
        incoming().jabas is number && incoming().jabas >= 0;
      allow delete: if isSupervisorOrAdmin();
    }

    // Validaciones (Supervisor Harvest Validations)
    match /validaciones/{validacionId} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidId(validacionId) &&
        incoming().fecha is string && incoming().fecha.size() <= 32 &&
        incoming().supervisor is string && incoming().supervisor.size() <= 128 &&
        incoming().fundo is string && incoming().fundo.size() <= 64;
      allow delete: if isSupervisorOrAdmin();
    }

    // Programas (Daily Harvest Programs)
    match /programas/{programaId} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidId(programaId) &&
        incoming().fecha is string && incoming().fecha.size() <= 32 &&
        incoming().fundo is string && incoming().fundo.size() <= 64;
      allow delete: if isSupervisorOrAdmin();
    }

    // Programa General (Master Harvest Program)
    match /programa_general/{progGenId} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidId(progGenId) &&
        incoming().fundo is string && incoming().fundo.size() <= 64;
      allow delete: if isSupervisorOrAdmin();
    }
  }
}
